# Brewfile — dependencies for this rice (install with: brew bundle)

# SketchyBar status bar + its data sources
tap "FelixKratz/formulae"
brew "sketchybar"   # the bar itself
brew "jq"           # toggle_stats.sh state parsing
brew "ifstat"       # network.sh up/down throughput
brew "tmux"         # tmux.conf target

# Spotify + Spicetify (themed Spotify client)
cask "spotify"
brew "spicetify-cli"

# Fonts
cask "font-caskaydia-cove-nerd-font"   # bar icon/label font (CaskaydiaCove Nerd Font)

# SF Pro / SF Symbols — used for Apple glyph icons (date, battery, media, volume).
# If this cask is unavailable, download "SF Pro" + "SF Symbols" from
# https://developer.apple.com/fonts/ instead.
cask "font-sf-pro"

# Window manager that drives the native Spaces shown in the bar
cask "amethyst"
